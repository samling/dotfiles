[Unit]
Description=Paseo daemon

[Service]
Type=simple
WorkingDirectory=%h
# Load shell-configured agent paths on each start. %H is this machine's hostname.
# Configure a Paseo password before enabling LAN access.
ExecStart=/usr/bin/zsh -lic 'exec /usr/bin/paseo daemon run'
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
