#!/usr/bin/env bash
jq -s '
  (.[0] // {})
  | .packages = (
      ((.packages // []) + [
        "npm:@tintinweb/pi-subagents@latest",
        "npm:pi-catppuccin-tui@latest",
        "git:github.com/EveryInc/compound-engineering-plugin",
        "npm:pi-mcp-adapter@latest",
        "npm:@narumitw/pi-plan-mode@latest",
        "npm:@juicesharp/rpiv-ask-user-question@latest",
        "npm:pi-lens@latest",
        "npm:@gotgenes/pi-permission-system@latest",
        "npm:pi-background-tasks@latest",
        "npm:pi-hermes-memory@latest",
        "npm:@plannotator/pi-extension@latest",
        "npm:pi-powerline-footer@latest"
      ])
      | reduce .[] as $package ([];
          if index($package) == null then . + [$package] else . end
        )
    )
  | .powerline.separator = "dot"
'
