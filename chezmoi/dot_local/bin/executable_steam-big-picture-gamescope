#!/usr/bin/env bash

### Usage:
### Configure a new Sunshine application profile that calls this script
### as its main command: /home/sboynton/.local/bin/steam-big-picture-gamescope
###
### Adjust STREAM_OUTPUT to the desired display and WIDTH/HEIGHT to that display's
### resolution for the best experience.
###
### This should also skip any scopebuddy invocation with SCB_NOSCOPE=1 in the launch options.

STEAM_WAS_RUNNING=false
if pgrep -x steam >/dev/null; then
    STEAM_WAS_RUNNING=true
fi

GAMESCOPE_PID=""
CLEANUP_DONE=false

cleanup() {
    local exit_status=$?

    trap - EXIT TERM INT HUP

    if $CLEANUP_DONE; then
        exit "$exit_status"
    fi
    CLEANUP_DONE=true

    if [[ -n "$GAMESCOPE_PID" ]] && kill -0 "$GAMESCOPE_PID" 2>/dev/null; then
        kill -TERM "$GAMESCOPE_PID" 2>/dev/null || true
        wait "$GAMESCOPE_PID" 2>/dev/null || true
    fi

    if $STEAM_WAS_RUNNING; then
        while pgrep -x steam >/dev/null; do
            sleep 0.25
        done

        systemd-run \
            --user \
            --quiet \
            --collect \
            --unit="steam-after-sunshine-${BASHPID}" \
            -- \
            /usr/bin/steam -silent
    fi

    exit "$exit_status"
}

trap cleanup EXIT TERM INT HUP

# Shut down any desktop Steam instance.
steam -shutdown >/dev/null 2>&1 || true

# Give Steam time to exit.
while pgrep -x steam >/dev/null; do
    sleep 0.25
done

STREAM_OUTPUT="DP-1"   # change this

# WIDTH="${SUNSHINE_CLIENT_WIDTH:-2560}"
# HEIGHT="${SUNSHINE_CLIENT_HEIGHT:-1440}"
WIDTH=2560
HEIGHT=1440
FPS="${SUNSHINE_CLIENT_FPS:-60}"

# Remember existing Gamescope windows so we don't accidentally manipulate one
# that was already running locally.
mapfile -t OLD_IDS < <(
    niri msg --json windows |
        jq -r '.[] | select(.app_id == "gamescope") | .id'
)

gamescope \
    --steam \
    --grab \
    --force-grab-cursor \
    --force-windows-fullscreen \
    -W "$WIDTH" \
    -H "$HEIGHT" \
    -w "$WIDTH" \
    -h "$HEIGHT" \
    -r "$FPS" \
    -- \
    env SCB_NOSCOPE=1 steam -gamepadui &

GAMESCOPE_PID=$!

# Wait for a NEW Gamescope window.
WINDOW_ID=""

for _ in {1..100}; do
    while read -r id; do
        already_existed=false

        for old_id in "${OLD_IDS[@]}"; do
            if [[ "$id" == "$old_id" ]]; then
                already_existed=true
                break
            fi
        done

        if ! $already_existed; then
            WINDOW_ID="$id"
            break 2
        fi
    done < <(
        niri msg --json windows |
            jq -r '.[] | select(.app_id == "gamescope") | .id'
    )

    kill -0 "$GAMESCOPE_PID" 2>/dev/null || exit 1
    sleep 0.1
done

if [[ -z "$WINDOW_ID" ]]; then
    echo "Could not find new Gamescope window" >&2
    exit 1
fi

niri msg action move-window-to-monitor --id "$WINDOW_ID" "$STREAM_OUTPUT"
niri msg action fullscreen-window --id "$WINDOW_ID"
niri msg action focus-window --id "$WINDOW_ID"

wait "$GAMESCOPE_PID"






































